  "settings": {
    "history": {
      "keepYears": 1,
      "keepPeriods": 150,
      "startYear": 2026,
      "description": "保留2026全年历史数据"
    },
    "crawler": {
      "userAgent": "Mozilla/5.0 (Windows NT 10.0; Win64; x64) AppleWebKit/537.36",
      "timeout": 30000,
      "retryAttempts": 3,
      "retryDelay": 2000,
      "concurrentRequests": 5,
      "rateLimitPerMinute": 30,
      "delayBetweenRequests": 2000
    },
    "imageProcessing": {
      "maxWidth": 1200,
      "quality": 85,
      "format": "jpeg",
      "optimize": true,
      "targetSizeKB": 80
    },
    "storage": {
      "provider": "cloudflare-r2",
      "bucket": "lottery-materials",
      "publicUrl": "${R2_PUBLIC_URL}",
      "pathPrefix": "materials/",
      "pathPattern": "{region}/{materialId}/{year}/{period}.jpg"
    },
    "database": {
      "provider": "cloudflare-d1",
      "name": "lottery-db",
      "tables": {
        "materials": "materials",
        "periods": "lottery_periods",
        "crawlLogs": "crawl_logs"
      }
    },
    "schedule": {
      "timezone": "Asia/Shanghai",
      "updateTimes": [
        {
          "name": "after_draw",
          "description": "开奖后自动检查",
          "trigger": "event",
          "regions": ["macao", "hongkong"]
        },
        {
          "name": "morning",
          "time": "03:00",
          "description": "凌晨3点检查",
          "trigger": "cron",
          "cron": "0 19 * * *",
          "regions": ["macao", "hongkong"]
        },
        {
          "name": "afternoon",
          "time": "15:00",
          "description": "下午3点检查",
          "trigger": "cron",
          "cron": "0 7 * * *",
          "regions": ["macao", "hongkong"]
        }
      ],
      "drawSchedule": {
        "macao": {
          "frequency": "daily",
          "time": "21:30",
          "description": "澳门每天开奖"
        },
        "hongkong": {
          "frequency": "every_2_days",
          "days": [2, 4, 6],
          "time": "21:30",
          "description": "香港每周二四六开奖"
        }
      }
    },
    "notification": {
      "enabled": true,
      "onSuccess": false,
      "onFailure": true,
      "email": "${NOTIFICATION_EMAIL}"
    }
  }
}